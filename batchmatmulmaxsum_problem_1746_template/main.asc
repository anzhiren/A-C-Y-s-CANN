// Local test main
// Usage:
//   ./batch_matmul_max_sum_custom
//   ./batch_matmul_max_sum_custom B M K N
//
// Examples:
//   ./batch_matmul_max_sum_custom 1 1 32 1
//   ./batch_matmul_max_sum_custom 1 1 32 8
//
// Current parameterized test path:
//   Layout = NN
//   dtype  = FP16
//   X1     = [B, M, K]
//   X2     = [B, K, N]
//   Y      = [B], FP32

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED

// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};

struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};

#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr)                                                        \
    do {                                                                       \
        aclError _ret = (expr);                                                \
        if (_ret != 0) {                                                       \
            fprintf(stderr,                                                    \
                    "[ERROR] %s failed at %s:%d, ret=%d\n",                    \
                    #expr, __FILE__, __LINE__, _ret);                          \
            return 1;                                                          \
        }                                                                      \
    } while (0)

#define FILE_CHECK(expr)                                                       \
    do {                                                                       \
        if (!(expr)) {                                                         \
            fprintf(stderr,                                                    \
                    "[ERROR] File I/O failed at %s:%d\n",                      \
                    __FILE__, __LINE__);                                       \
            return 1;                                                          \
        }                                                                      \
    } while (0)

#include "kernel.asc"

int main(int argc, char **argv)
{
    // ---------------------------------------------------------
    // 1. Parse test shape
    // ---------------------------------------------------------

    // Default: original baseline case
    int64_t B = 1;
    int64_t M = 1;
    int64_t K = 32;
    int64_t N = 1;

    if (argc != 1 && argc != 5) {
        fprintf(stderr,
                "Usage:\n"
                "  %s\n"
                "  %s B M K N\n\n"
                "Example:\n"
                "  %s 1 1 32 8\n",
                argv[0], argv[0], argv[0]);
        return 1;
    }

    if (argc == 5) {
        B = std::strtoll(argv[1], nullptr, 10);
        M = std::strtoll(argv[2], nullptr, 10);
        K = std::strtoll(argv[3], nullptr, 10);
        N = std::strtoll(argv[4], nullptr, 10);

        if (B <= 0 || M <= 0 || K <= 0 || N <= 0) {
            fprintf(stderr,
                    "[ERROR] B, M, K and N must all be positive.\n");
            return 1;
        }
    }

    printf("========================================\n");
    printf("BatchMatmulMaxSum local test\n");
    printf("B=%lld, M=%lld, K=%lld, N=%lld\n",
           static_cast<long long>(B),
           static_cast<long long>(M),
           static_cast<long long>(K),
           static_cast<long long>(N));
    printf("Layout=NN, dtype=FP16\n");
    printf("========================================\n");

    // ---------------------------------------------------------
    // 2. Initialize ACL
    // ---------------------------------------------------------

    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));

    ACL_CHECK(
        aclrtGetDeviceInfo(
            deviceId,
            ACL_DEV_ATTR_CUBE_CORE_NUM,
            &availableCoreNum));

    if (availableCoreNum <= 0) {
        fprintf(stderr, "[ERROR] No available Cube core.\n");
        return 1;
    }

    ACL_CHECK(aclrtCreateStream(&stream));

    // ---------------------------------------------------------
    // 3. Tensor shape / dtype info
    //
    // NN:
    //   X1 = [B, M, K]
    //   X2 = [B, K, N]
    //   Y  = [B]
    // ---------------------------------------------------------

    int64_t x1_0_shape[] = {B, M, K};

    TensorInfo x1_tensors[] = {
        {x1_0_shape, 3, 1}   // FP16
    };

    TensorGroupInfo info_x1 = {
        x1_tensors,
        1
    };


    int64_t x2_0_shape[] = {B, K, N};

    TensorInfo x2_tensors[] = {
        {x2_0_shape, 3, 1}   // FP16
    };

    TensorGroupInfo info_x2 = {
        x2_tensors,
        1
    };


    int64_t y_0_shape[] = {B};

    TensorInfo y_tensors[] = {
        {y_0_shape, 1, 0}    // FP32
    };

    TensorGroupInfo info_y = {
        y_tensors,
        1
    };


    bool transposeX1 = false;
    bool transposeX2 = false;

    // ---------------------------------------------------------
    // 4. Calculate memory size dynamically
    // ---------------------------------------------------------

    // FP16 = 2 bytes
    const size_t x1Bytes =
        static_cast<size_t>(B) *
        static_cast<size_t>(M) *
        static_cast<size_t>(K) *
        sizeof(uint16_t);

    const size_t x2Bytes =
        static_cast<size_t>(B) *
        static_cast<size_t>(K) *
        static_cast<size_t>(N) *
        sizeof(uint16_t);

    // Output Y is FP32: [B]
    const size_t yBytes =
        static_cast<size_t>(B) *
        sizeof(float);

    printf("[MEM] x1=%zu bytes, x2=%zu bytes, y=%zu bytes\n",
           x1Bytes,
           x2Bytes,
           yBytes);

    // ---------------------------------------------------------
    // 5. Allocate input / output memory
    // ---------------------------------------------------------

    uint8_t *inputHost_x1 = nullptr;
    uint8_t *inputDevice_x1 = nullptr;

    uint8_t *inputHost_x2 = nullptr;
    uint8_t *inputDevice_x2 = nullptr;

    uint8_t *outputHost_y = nullptr;
    uint8_t *outputDevice_y = nullptr;


    // X1
    ACL_CHECK(
        aclrtMallocHost(
            reinterpret_cast<void **>(&inputHost_x1),
            x1Bytes));

    ACL_CHECK(
        aclrtMalloc(
            reinterpret_cast<void **>(&inputDevice_x1),
            x1Bytes,
            ACL_MEM_MALLOC_HUGE_FIRST));

    FILE_CHECK(
        ReadFile(
            "./input/x1.bin",
            x1Bytes,
            inputHost_x1,
            x1Bytes));

    ACL_CHECK(
        aclrtMemcpy(
            inputDevice_x1,
            x1Bytes,
            inputHost_x1,
            x1Bytes,
            ACL_MEMCPY_HOST_TO_DEVICE));


    // X2
    ACL_CHECK(
        aclrtMallocHost(
            reinterpret_cast<void **>(&inputHost_x2),
            x2Bytes));

    ACL_CHECK(
        aclrtMalloc(
            reinterpret_cast<void **>(&inputDevice_x2),
            x2Bytes,
            ACL_MEM_MALLOC_HUGE_FIRST));

    FILE_CHECK(
        ReadFile(
            "./input/x2.bin",
            x2Bytes,
            inputHost_x2,
            x2Bytes));

    ACL_CHECK(
        aclrtMemcpy(
            inputDevice_x2,
            x2Bytes,
            inputHost_x2,
            x2Bytes,
            ACL_MEMCPY_HOST_TO_DEVICE));


    // Y
    ACL_CHECK(
        aclrtMallocHost(
            reinterpret_cast<void **>(&outputHost_y),
            yBytes));

    ACL_CHECK(
        aclrtMalloc(
            reinterpret_cast<void **>(&outputDevice_y),
            yBytes,
            ACL_MEM_MALLOC_HUGE_FIRST));

    // ---------------------------------------------------------
    // 6. Run kernel
    // ---------------------------------------------------------

    run_kernel(
        (GM_ADDR)inputDevice_x1,
        info_x1,
        (GM_ADDR)inputDevice_x2,
        info_x2,
        (GM_ADDR)outputDevice_y,
        info_y,
        availableCoreNum,
        stream,
        transposeX1,
        transposeX2);

    auto sync_ret_ =
        aclrtSynchronizeStreamWithTimeout(stream, 3000);

    if (sync_ret_ != 0) {
        fprintf(stderr,
                "[ERROR] aclrtSynchronizeStreamWithTimeout "
                "failed, ret=%d\n",
                sync_ret_);
        return 1;
    }

    // ---------------------------------------------------------
    // 7. Copy result back
    // ---------------------------------------------------------

    ACL_CHECK(
        aclrtMemcpy(
            outputHost_y,
            yBytes,
            outputDevice_y,
            yBytes,
            ACL_MEMCPY_DEVICE_TO_HOST));

    FILE_CHECK(
        WriteFile(
            "./output/y.bin",
            outputHost_y,
            yBytes));

    // ---------------------------------------------------------
    // 8. Release resources
    // ---------------------------------------------------------

    if (inputDevice_x1) {
        aclrtFree(inputDevice_x1);
    }

    if (inputHost_x1) {
        aclrtFreeHost(inputHost_x1);
    }

    if (inputDevice_x2) {
        aclrtFree(inputDevice_x2);
    }

    if (inputHost_x2) {
        aclrtFreeHost(inputHost_x2);
    }

    if (outputDevice_y) {
        aclrtFree(outputDevice_y);
    }

    if (outputHost_y) {
        aclrtFreeHost(outputHost_y);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}