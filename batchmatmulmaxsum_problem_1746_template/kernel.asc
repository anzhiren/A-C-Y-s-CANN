#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

#define BUFFER_NUM 2

// ==================== Tiling 结构体 ====================
struct BatchMatmulMaxSumTilling {
    AscendC::tiling::TCubeTiling cubeTilingData;
    uint32_t B;
    uint32_t reduceMaxTmpSize;
    uint32_t reduceSumTmpSize;
    bool transposeX1;
    bool transposeX2;

    uint32_t mBlocksPerBatch;
    uint32_t totalTasks;
    uint32_t tasksPerCore;
    uint32_t coreNum;
};

// ==================== GenerateTiling ====================
BatchMatmulMaxSumTilling GenerateTiling(
    platform_ascendc::PlatformAscendC* ascendcPlatform,
    uint32_t B, uint32_t M, uint32_t N, uint32_t K,
    bool transposeX1, bool transposeX2,
    uint32_t baseM, uint32_t baseN, uint32_t coreNum,
    int32_t dtype /* 1=fp16, 2=bf16 */)
{
    constexpr uint32_t MIN_BASE = 16;
    uint32_t alignedM = ((M + MIN_BASE - 1) / MIN_BASE) * MIN_BASE;
    uint32_t alignedN = ((N + MIN_BASE - 1) / MIN_BASE) * MIN_BASE;
    if (alignedM < MIN_BASE) alignedM = MIN_BASE;
    if (alignedN < MIN_BASE) alignedN = MIN_BASE;

    uint32_t actualBaseM = (M < baseM) ? alignedM : baseM;
    uint32_t actualBaseN = (N < baseN) ? alignedN : baseN;

    std::fprintf(stderr,
        "[INFO] GenerateTiling: B=%u M=%u N=%u K=%u dtype=%d -> actualBaseM=%u actualBaseN=%u\n",
        B, M, N, K, dtype, actualBaseM, actualBaseN);

    matmul_tiling::MultiCoreMatmulTiling cubeTiling(*ascendcPlatform);
    cubeTiling.SetDim(1);

    auto dt = (dtype == 2) ? matmul_tiling::DataType::DT_BFLOAT16
                           : matmul_tiling::DataType::DT_FLOAT16;

    cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dt);
    cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dt);
    cubeTiling.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT);
    cubeTiling.SetShape(M, N, K);
    cubeTiling.SetOrgShape(M, N, K);
    cubeTiling.SetFixSplit(actualBaseM, actualBaseN, -1);
    cubeTiling.SetBatchInfoForNormal(B, B, M, N, K);
    cubeTiling.SetBufferSpace(-1, -1, -1);

    AscendC::tiling::TCubeTiling cubeTilingData;
    if (cubeTiling.GetTiling(cubeTilingData) == -1) {
        std::fprintf(stderr,
            "[FATAL] Generate matmul tiling failed: "
            "B=%u M=%u N=%u K=%u baseM=%u baseN=%u\n",
            B, M, N, K, actualBaseM, actualBaseN);
        std::abort();
    }

    std::fprintf(stderr,
        "[INFO] Tiling OK: baseM=%d baseN=%d baseK=%d\n",
        cubeTilingData.baseM, cubeTilingData.baseN, cubeTilingData.baseK);

    ge::Shape maxShape({static_cast<int64_t>(actualBaseM),
                        static_cast<int64_t>(actualBaseN)});
    uint32_t maxTmpMax = 0, maxTmpMin = 0;
    AscendC::GetReduceMaxMaxMinTmpSize(
        maxShape, ge::DataType::DT_FLOAT, AscendC::ReducePattern::AR,
        false, false, maxTmpMax, maxTmpMin);

    ge::Shape sumShape({static_cast<int64_t>(actualBaseM), 1});
    uint32_t sumTmpMax = 0, sumTmpMin = 0;
    AscendC::GetReduceSumMaxMinTmpSize(
        sumShape, ge::DataType::DT_FLOAT, AscendC::ReducePattern::RA,
        false, false, sumTmpMax, sumTmpMin);

    BatchMatmulMaxSumTilling tilling;
    tilling.cubeTilingData    = cubeTilingData;
    tilling.B                 = B;
    tilling.reduceMaxTmpSize  = maxTmpMin;
    tilling.reduceSumTmpSize  = sumTmpMin;
    tilling.transposeX1       = transposeX1;
    tilling.transposeX2       = transposeX2;
    tilling.mBlocksPerBatch   = (M + actualBaseM - 1) / actualBaseM;
    tilling.totalTasks        = B * tilling.mBlocksPerBatch;
    tilling.tasksPerCore      = (tilling.totalTasks + coreNum - 1) / coreNum;
    tilling.coreNum           = coreNum;
    return tilling;
}

// ==================== 工具函数 ====================
__aicore__ inline uint32_t Ceiling(uint32_t a, uint32_t b) {
    return (a + b - 1) / b;
}

// ==================== Kernel 类（模板化，支持 half / bfloat16_t） ====================
template <typename InputType>
class BatchMatmulMaxSumKernel {
public:
    AscendC::Matmul<
        AscendC::MatmulType<AscendC::TPosition::GM,    CubeFormat::ND, InputType, true>,
        AscendC::MatmulType<AscendC::TPosition::GM,    CubeFormat::ND, InputType, true>,
        AscendC::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, float>>
        matmulObj;

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* ans,
                                __gm__ uint8_t* workspace,
                                const BatchMatmulMaxSumTilling& tilling,
                                AscendC::TPipe* pipe);
    __aicore__ inline void Process();

private:
    __aicore__ inline void MatmulCompute();
    __aicore__ inline void GetPartialMax(uint32_t actualM, uint32_t actualN);
    __aicore__ inline void UpdateRunningMax(uint32_t actualM);
    __aicore__ inline void SumUpCompute(uint32_t actualM);
    __aicore__ inline void ProcessSmallCase(uint32_t blockIdx);

    // 标量转换辅助：统一走 AscendC 接口，避免触发 static_cast<bf16>
    __aicore__ inline float ScalarToFloat(InputType v) {
        return AscendC::ToFloat(v);
    }

    AscendC::GlobalTensor<InputType> aGlobal;
    AscendC::GlobalTensor<InputType> bGlobal;
    AscendC::GlobalTensor<float>     ansGlobal;
    AscendC::GlobalTensor<float>     workspaceGlobal;

    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> cQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> partialMaxQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> ansQueue;

    AscendC::TBuf<AscendC::TPosition::VECCALC> maxTmpBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumTmpBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> runningMaxBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> localYBuf;

    BatchMatmulMaxSumTilling tilling;
};

// ==================== Init ====================
template <typename InputType>
__aicore__ inline void BatchMatmulMaxSumKernel<InputType>::Init(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* ans,
    __gm__ uint8_t* workspace,
    const BatchMatmulMaxSumTilling& tilling, AscendC::TPipe* pipe)
{
    this->tilling = tilling;
    const auto& ctd = tilling.cubeTilingData;

    const uint32_t baseM_u = static_cast<uint32_t>(ctd.baseM);
    const uint32_t baseN_u = static_cast<uint32_t>(ctd.baseN);

    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ InputType*>(a), tilling.B * ctd.M * ctd.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ InputType*>(b), tilling.B * ctd.Kb * ctd.N);
    ansGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ans), tilling.B);
    workspaceGlobal.SetGlobalBuffer(
        reinterpret_cast<__gm__ float*>(workspace),
        tilling.coreNum * tilling.B);

    pipe->InitBuffer(cQueue,          BUFFER_NUM, baseM_u * baseN_u * sizeof(float));
    pipe->InitBuffer(partialMaxQueue, BUFFER_NUM, baseM_u * sizeof(float));
    pipe->InitBuffer(ansQueue,        BUFFER_NUM, sizeof(float));

    pipe->InitBuffer(maxTmpBuf,       tilling.reduceMaxTmpSize);
    pipe->InitBuffer(sumTmpBuf,       tilling.reduceSumTmpSize);
    pipe->InitBuffer(runningMaxBuf,   baseM_u * sizeof(float));
    pipe->InitBuffer(localYBuf,       tilling.B * sizeof(float));
}

// ==================== 极小 case 标量 fallback ====================
template <typename InputType>
__aicore__ inline void BatchMatmulMaxSumKernel<InputType>::ProcessSmallCase(uint32_t blockIdx)
{
    const auto& ctd = tilling.cubeTilingData;

    const uint32_t baseM_u = static_cast<uint32_t>(ctd.baseM);
    const uint32_t M_u     = static_cast<uint32_t>(ctd.M);
    const uint32_t N_u     = static_cast<uint32_t>(ctd.N);
    const uint32_t Ka_u    = static_cast<uint32_t>(ctd.Ka);
    const uint32_t Kb_u    = static_cast<uint32_t>(ctd.Kb);

    const uint32_t mBlocks = tilling.mBlocksPerBatch;

    AscendC::LocalTensor<float> localY = localYBuf.Get<float>();
    AscendC::Duplicate(localY, 0.0f, tilling.B);

    uint32_t myStart = blockIdx * tilling.tasksPerCore;
    uint32_t myEnd = myStart + tilling.tasksPerCore;
    if (myEnd > tilling.totalTasks) myEnd = tilling.totalTasks;

    for (uint32_t task = myStart; task < myEnd; ++task) {
        uint32_t b = task / mBlocks;
        uint32_t mBlock = task % mBlocks;
        uint32_t actualM = (mBlock == mBlocks - 1) ? (M_u - mBlock * baseM_u) : baseM_u;

        float ySum = 0.0f;
        for (uint32_t mm = 0; mm < actualM; ++mm) {
            uint32_t m = mBlock * baseM_u + mm;
            float maxVal = -3.402823466e+38f;
            for (uint32_t n = 0; n < N_u; ++n) {
                float sum = 0.0f;
                for (uint32_t k = 0; k < Ka_u; ++k) {
                    uint64_t aIdx = tilling.transposeX1
                        ? (static_cast<uint64_t>(b) * Ka_u + k) * M_u + m
                        : (static_cast<uint64_t>(b) * M_u + m) * Ka_u + k;
                    uint64_t bIdx = tilling.transposeX2
                        ? (static_cast<uint64_t>(b) * N_u + n) * Kb_u + k
                        : (static_cast<uint64_t>(b) * Kb_u + k) * N_u + n;

                    // 关键：统一走 AscendC::ToFloat，避免任何 static_cast<bf16>
                    InputType aVal = aGlobal.GetValue(aIdx);
                    InputType bVal = bGlobal.GetValue(bIdx);
                    float a = ScalarToFloat(aVal);
                    float bv = ScalarToFloat(bVal);
                    sum += a * bv;
                }
                if (sum > maxVal) maxVal = sum;
            }
            ySum += maxVal;
        }
        localY.SetValue(b, localY.GetValue(b) + ySum);
    }

    for (uint32_t b = 0; b < tilling.B; ++b) {
        workspaceGlobal.SetValue(blockIdx * tilling.B + b, localY.GetValue(b));
    }
}

// ==================== Process ====================
template <typename InputType>
__aicore__ inline void BatchMatmulMaxSumKernel<InputType>::Process()
{
    const auto& ctd = tilling.cubeTilingData;

    const uint32_t baseM_u = static_cast<uint32_t>(ctd.baseM);
    const uint32_t baseN_u = static_cast<uint32_t>(ctd.baseN);
    const uint32_t M_u     = static_cast<uint32_t>(ctd.M);
    const uint32_t N_u     = static_cast<uint32_t>(ctd.N);
    const uint32_t Ka_u    = static_cast<uint32_t>(ctd.Ka);
    const uint32_t Kb_u    = static_cast<uint32_t>(ctd.Kb);

    const uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());

    if (M_u < baseM_u || N_u < baseN_u) {
        ProcessSmallCase(blockIdx);
        return;
    }

    const uint32_t mBlocks = tilling.mBlocksPerBatch;
    const uint32_t nBlocks = Ceiling(N_u, baseN_u);

    AscendC::LocalTensor<float> localY = localYBuf.Get<float>();
    AscendC::Duplicate(localY, 0.0f, tilling.B);

    uint32_t myStart = blockIdx * tilling.tasksPerCore;
    uint32_t myEnd = myStart + tilling.tasksPerCore;
    if (myEnd > tilling.totalTasks) myEnd = tilling.totalTasks;

    for (uint32_t task = myStart; task < myEnd; ++task) {
        uint32_t b = task / mBlocks;
        uint32_t mBlock = task % mBlocks;

        uint32_t actualM = (mBlock == mBlocks - 1)
                         ? (M_u - mBlock * baseM_u)
                         : baseM_u;

        AscendC::LocalTensor<float> runningMax = runningMaxBuf.Get<float>();
        AscendC::Duplicate(runningMax, -3.402823466e+38f, baseM_u);

        for (uint32_t nBlock = 0; nBlock < nBlocks; ++nBlock) {
            uint32_t actualN = (nBlock == nBlocks - 1)
                             ? (N_u - nBlock * baseN_u)
                             : baseN_u;

            uint64_t aOff, bOff;
            if (!tilling.transposeX1) {
                aOff = static_cast<uint64_t>(b) * M_u * Ka_u
                     + static_cast<uint64_t>(mBlock) * baseM_u * Ka_u;
            } else {
                aOff = static_cast<uint64_t>(b) * Ka_u * M_u
                     + static_cast<uint64_t>(mBlock) * baseM_u;
            }
            if (!tilling.transposeX2) {
                bOff = static_cast<uint64_t>(b) * Kb_u * N_u
                     + static_cast<uint64_t>(nBlock) * baseN_u;
            } else {
                bOff = static_cast<uint64_t>(b) * N_u * Kb_u
                     + static_cast<uint64_t>(nBlock) * baseN_u * Kb_u;
            }

            matmulObj.SetTensorA(aGlobal[aOff], tilling.transposeX1);
            matmulObj.SetTensorB(bGlobal[bOff], tilling.transposeX2);

            while (matmulObj.template Iterate<true>()) {
                MatmulCompute();
                GetPartialMax(actualM, actualN);
                UpdateRunningMax(actualM);
            }
            matmulObj.End();
        }

        SumUpCompute(actualM);

        AscendC::LocalTensor<float> yLocal = ansQueue.DeQue<float>();
        float partialY = yLocal.GetValue(0);
        ansQueue.FreeTensor(yLocal);

        localY.SetValue(b, localY.GetValue(b) + partialY);
    }

    for (uint32_t b = 0; b < tilling.B; ++b) {
        workspaceGlobal.SetValue(blockIdx * tilling.B + b, localY.GetValue(b));
    }
}

// ==================== MatmulCompute ====================
template <typename InputType>
__aicore__ inline void BatchMatmulMaxSumKernel<InputType>::MatmulCompute()
{
    AscendC::LocalTensor<float> cLocal = cQueue.AllocTensor<float>();
    matmulObj.template GetTensorC<true>(cLocal, false, true);
    cQueue.EnQue(cLocal);
}

// ==================== GetPartialMax ====================
template <typename InputType>
__aicore__ inline void BatchMatmulMaxSumKernel<InputType>::GetPartialMax(
    uint32_t actualM, uint32_t actualN)
{
    AscendC::LocalTensor<float> cLocal     = cQueue.DeQue<float>();
    AscendC::LocalTensor<float> partialMax = partialMaxQueue.AllocTensor<float>();
    AscendC::LocalTensor<uint8_t> maxTmp   = maxTmpBuf.Get<uint8_t>();

    uint32_t srcShape[2];
    srcShape[0] = actualM;
    srcShape[1] = actualN;

    bool srcInnerPad = (actualN % 8) != 0;

    AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, false>(
        partialMax, cLocal, maxTmp, srcShape, srcInnerPad);

    cQueue.FreeTensor(cLocal);
    partialMaxQueue.EnQue(partialMax);
}

// ==================== UpdateRunningMax ====================
template <typename InputType>
__aicore__ inline void BatchMatmulMaxSumKernel<InputType>::UpdateRunningMax(uint32_t actualM)
{
    AscendC::LocalTensor<float> partialMax = partialMaxQueue.DeQue<float>();
    AscendC::LocalTensor<float> runningMax = runningMaxBuf.Get<float>();

    AscendC::Max(runningMax, runningMax, partialMax, actualM);

    partialMaxQueue.FreeTensor(partialMax);
}

// ==================== SumUpCompute ====================
template <typename InputType>
__aicore__ inline void BatchMatmulMaxSumKernel<InputType>::SumUpCompute(uint32_t actualM)
{
    AscendC::LocalTensor<float> runningMax = runningMaxBuf.Get<float>();
    AscendC::LocalTensor<float> ansLocal   = ansQueue.AllocTensor<float>();
    AscendC::LocalTensor<uint8_t> sumTmp   = sumTmpBuf.Get<uint8_t>();

    uint32_t srcShape[2];
    srcShape[0] = actualM;
    srcShape[1] = 1U;

    bool srcInnerPad = true;

    AscendC::ReduceSum<float, AscendC::Pattern::Reduce::RA, false>(
        ansLocal, runningMax, sumTmp, srcShape, srcInnerPad);

    ansQueue.EnQue(ansLocal);
}

// ==================== Kernel 入口：fp16 / bf16 分发 ====================
extern "C" __global__ __mix__(1, 2) void batch_matmul_max_sum_fp16(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* ans,
    __gm__ uint8_t* workspace,
    __gm__ uint8_t* __kfc_workspace__ sysWorkspace,
    BatchMatmulMaxSumTilling tilling)
{
    AscendC::TPipe pipe;
    BatchMatmulMaxSumKernel<half> op;
    op.Init(a, b, ans, workspace, tilling, &pipe);
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.matmulObj, &tilling.cubeTilingData);
    op.Process();
}

extern "C" __global__ __mix__(1, 2) void batch_matmul_max_sum_bf16(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* ans,
    __gm__ uint8_t* workspace,
    __gm__ uint8_t* __kfc_workspace__ sysWorkspace,
    BatchMatmulMaxSumTilling tilling)
{
    AscendC::TPipe pipe;
    BatchMatmulMaxSumKernel<bfloat16_t> op;
    op.Init(a, b, ans, workspace, tilling, &pipe);
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.matmulObj, &tilling.cubeTilingData);
    op.Process();
}

// ==================== Kernel 2：跨核归约 ====================
__global__ __aicore__ void reduce_workspace_kernel(
    __gm__ uint8_t* ans,
    __gm__ uint8_t* workspace,
    uint32_t B, uint32_t coreNum)
{
    AscendC::GlobalTensor<float> ansGlobal;
    AscendC::GlobalTensor<float> wsGlobal;
    ansGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ans), B);
    wsGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(workspace), coreNum * B);

    for (uint32_t b = 0; b < B; ++b) {
        float sum = 0.0f;
        for (uint32_t c = 0; c < coreNum; ++c) {
            sum += wsGlobal.GetValue(c * B + b);
        }
        ansGlobal.SetValue(b, sum);
    }
}

// ==================== Host 侧 run_kernel ====================
extern "C" void run_kernel(
    GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y,  const TensorGroupInfo& info_y,
    int64_t availableCoreNum,
    aclrtStream stream,
    bool transposeX1, bool transposeX2)
{
    const int64_t* x1Shape = info_x1.tensors[0].shape;
    const int64_t* x2Shape = info_x2.tensors[0].shape;
    int32_t dtype = info_x1.tensors[0].dtype;   // 1=fp16, 2=bf16

    uint32_t B = static_cast<uint32_t>(x1Shape[0]);
    uint32_t M, K, N;

    if (!transposeX1) {
        M = static_cast<uint32_t>(x1Shape[1]);
        K = static_cast<uint32_t>(x1Shape[2]);
    } else {
        M = static_cast<uint32_t>(x1Shape[2]);
        K = static_cast<uint32_t>(x1Shape[1]);
    }
    if (!transposeX2) {
        N = static_cast<uint32_t>(x2Shape[2]);
    } else {
        N = static_cast<uint32_t>(x2Shape[1]);
    }

    uint32_t coreNum = static_cast<uint32_t>(availableCoreNum);

    std::fprintf(stderr, "[run_kernel] B=%u M=%u N=%u K=%u dtype=%d coreNum=%u\n",
                 B, M, N, K, dtype, coreNum);

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    BatchMatmulMaxSumTilling tilling = GenerateTiling(
        ascendcPlatform, B, M, N, K,
        transposeX1, transposeX2,
        128, 128, coreNum, dtype);

    size_t wsSize = static_cast<size_t>(coreNum) * B * sizeof(float);
    uint8_t* wsDevice = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&wsDevice), wsSize, ACL_MEM_MALLOC_HUGE_FIRST);

    if (dtype == 1) {
        batch_matmul_max_sum_fp16<<<coreNum, nullptr, stream>>>(
            x1, x2, y, wsDevice, nullptr, tilling);
    } else if (dtype == 2) {
        batch_matmul_max_sum_bf16<<<coreNum, nullptr, stream>>>(
            x1, x2, y, wsDevice, nullptr, tilling);
    } else {
        std::fprintf(stderr, "[FATAL] unsupported dtype=%d\n", dtype);
        std::abort();
    }

    reduce_workspace_kernel<<<1, nullptr, stream>>>(
        y, wsDevice, B, coreNum);

    aclrtFree(wsDevice);
}