#include <cmath>
#include "kernel_operator.h"
/*
 * BatchMatmulMaxSum Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __cube__ void batch_matmul_max_sum_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */
 __global__ __cube__ void batch_matmul_max_sum_fp16(
    GM_ADDR x1,
    GM_ADDR x2, 
    GM_ADDR y, 
    uint32_t B,
    uint32_t M,
    uint32_t N,
    uint32_t K,
    bool transposeX1,
    bool transposeX2)
{
    AscendC::GlobalTensor<half> x1Gm;
    AscendC::GlobalTensor<half> x2Gm;
    AscendC::GlobalTensor<float> yGm;

    x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1));
    x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));

    uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
    uint32_t blockNum = static_cast<uint32_t>(AscendC::GetBlockNum());

    for (uint32_t b = blockIdx; b < B; b += blockNum){
        float sumM = 0.0f;

        for (uint32_t m = 0; m < M; ++m) {
            float maxN = -3.402823466e+38f;

            for (uint32_t n = 0; n < N; ++n) {
                float acc = 0.0f;

                for (uint32_t k = 0; k < K; ++k) {
                    uint64_t x1Offset;
                    if (!transposeX1) {
                        x1Offset = (static_cast<uint64_t>(b) * M + m) * K + k;
                    } else {
                        x1Offset = (static_cast<uint64_t>(b) * K + k) * M + m;
                    }
                    uint64_t x2Offset;
                    if (!transposeX2) {
                        x2Offset = (static_cast<uint64_t>(b) * K + k) * N + n;
                    } else {
                        x2Offset = (static_cast<uint64_t>(b) * N + n) * K + k;
                    }

                    half a = x1Gm.GetValue(x1Offset);
                    half c = x2Gm.GetValue(x2Offset);
                    acc += static_cast<float>(a) * static_cast<float>(c);
                }
                if (acc > maxN) {
                    maxN = acc;
                }
            }
            sumM += maxN;
        }
        yGm.SetValue(b, sumM);
    }
}

__global__ __cube__ void batch_matmul_max_sum_bf16(
    GM_ADDR x1,
    GM_ADDR x2, 
    GM_ADDR y, 
    uint32_t B,
    uint32_t M,
    uint32_t N,
    uint32_t K,
    bool transposeX1,
    bool transposeX2)
{
    AscendC::GlobalTensor<bfloat16_t> x1Gm;
    AscendC::GlobalTensor<bfloat16_t> x2Gm;
    AscendC::GlobalTensor<float> yGm;

    x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x1));
    x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x2));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));

    uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
    uint32_t blockNum = static_cast<uint32_t>(AscendC::GetBlockNum());

    for (uint32_t b = blockIdx; b < B; b += blockNum){
        float sumM = 0.0f;

        for (uint32_t m = 0; m < M; ++m) {
            float maxN = -3.402823466e+38f;

            for (uint32_t n = 0; n < N; ++n) {
                float acc = 0.0f;

                for (uint32_t k = 0; k < K; ++k) {
                    uint64_t x1Offset;
                    if (!transposeX1) {
                        x1Offset = (static_cast<uint64_t>(b) * M + m) * K + k;
                    } else {
                        x1Offset = (static_cast<uint64_t>(b) * K + k) * M + m;
                    }
                    uint64_t x2Offset;
                    if (!transposeX2) {
                        x2Offset = (static_cast<uint64_t>(b) * K + k) * N + n;
                    } else {
                        x2Offset = (static_cast<uint64_t>(b) * N + n) * K + k;
                    }

                    bfloat16_t a = x1Gm.GetValue(x1Offset);
                    bfloat16_t c = x2Gm.GetValue(x2Offset);
                    float af = AscendC::ToFloat(a);
                    float cf = AscendC::ToFloat(c);
                    acc += af * cf;
                }
                if (acc > maxN) {
                    maxN = acc;
                }
            }
            sumM += maxN;
        }
        yGm.SetValue(b, sumM);
    }
}

extern "C" void run_kernel(
    GM_ADDR x1, 
    const TensorGroupInfo& info_x1,
    GM_ADDR x2,
    const TensorGroupInfo& info_x2,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    int64_t availableCoreNum,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    // TODO: define your launch kernel.
    //   batch_matmul_max_sum_custom<<<blockNum, nullptr, stream>>>(...);
    const int64_t* x1Shape = info_x1.tensors[0].shape;
    const int64_t* x2Shape = info_x2.tensors[0].shape;

    uint32_t B = static_cast<uint32_t>(x1Shape[0]);
    uint32_t M;
    uint32_t N;
    uint32_t K;
    if (!transposeX1) {
        M = static_cast<uint32_t>(x1Shape[1]);
        K = static_cast<uint32_t>(x1Shape[2]);
    } else {
        M = static_cast<uint32_t>(x1Shape[2]);
        K = static_cast<uint32_t>(x1Shape[1]);
    }
    if (!transposeX2) {
        N = static_cast<uint32_t>(x2Shape[2]);
    } else {
        N = static_cast<uint32_t>(x2Shape[1]);
    }

    uint32_t blockNum = 
        static_cast<uint32_t>(
            B < availableCoreNum ? B : availableCoreNum
        );

    int32_t dtype = info_x1.tensors[0].dtype;
    if (dtype == 1) {
        batch_matmul_max_sum_fp16<<<blockNum, nullptr, stream>>>(
            x1, x2, y, B, M, N, K, transposeX1, transposeX2
        );
    } else if (dtype == 2) {
        batch_matmul_max_sum_bf16<<<blockNum, nullptr, stream>>>(
            x1, x2, y, B, M, N, K, transposeX1, transposeX2
        );
    }
}
