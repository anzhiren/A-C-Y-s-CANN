#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

struct BatchMatmulMaxSumTilling{
    AscendC::tiling::TCubeTiling cubeTilingData;
    uint32_t B;
    uint32_t reduceMaxTmpSize;
    uint32_t reduceSumTmpSize;
};

BatchMatmulMaxSumTilling GenerateTiling(
    platform_ascendc::PlatformAscendC* ascendcPlatform,
    uint32_t B, uint32_t M, uint32_t N, uint32_t K,
    uint32_t baseM = 128, uint32_t baseN = 128, uint32_t coreNum = 2){
    matmul_tiling::MultiCoreMatmulTiling cubeTiling(*ascendcPlatform);
    cubeTiling.SetDim(1);
    cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT16);
    cubeTiling.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
    cubeTiling.SetShape(M, N, K);
    cubeTiling.SetOrgShape(M, N, K);
    cubeTiling.SetFixSplit(baseM, baseN, -1);
    cubeTiling.SetBatchInfoForNormal(B, B, M, N, K);
    cubeTiling.SetBufferSpace(-1, -1, -1);

    AscendC::tiling::TCubeTiling cubeTilingData;
    if (cubeTiling.GetTiling(cubeTilingData) == -1) {
        std::fprintf(stderr, "Generate matmul tiling failed.\n");
    }

    ge::Shape maxShape({static_cast<int64_t>(baseM), static_cast<int64_t>(baseN)});
    uint32_t maxTmpMax = 0, maxTmpMin = 0;
    AscendC::GetReduceMaxMaxMinTmpSize(
        maxShape, ge::DataType::DT_FLOAT, AscendC::ReducePattern::AR,
        false, false, maxTmpMax, maxTmpMin);

    ge::Shape sumShape({static_cast<int64_t>(baseM), 1});
    uint32_t sumTmpMax = 0, sumTmpMin = 0;
    AscendC::GetReduceSumMaxMinTmpSize(
        sumShape, ge::DataType::DT_FLOAT, AscendC::ReducePattern::RA,
        false, false, sumTmpMax, sumTmpMin);

    BatchMatmulMaxSumTilling tilling;
    tilling.cubeTilingData = cubeTilingData;
    tilling.B = B;
    tilling.reduceMaxTmpSize = maxTmpMin;
    tilling.reduceSumTmpSize = sumTmpMin;
    return tilling;
}

__aicore__ inline uint32_t Ceiling(uint32_t a, uint32_t b){
    return (a + b - 1) / b;
}

class BatchMatmulMaxSumKernel{
public:
    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* ans,
                                const BatchMatmulMaxSumTilling& tilling,
                                AscendC::TPipe* pipe);
    __aicore__ inline void Process();

private:
    __aicore__ inline void MatmulCompute();
    __aicore__ inline void GetPartialMax();
    __aicore__ inline void UpdateRunningMax();
    __aicore__ inline void SumUpCompute();

    AscendC::Matmul<
        AscendC::MatmulType<AscendC::TPosition::GM,    CubeFormat::ND, half>,
        AscendC::MatmulType<AscendC::TPosition::GM,    CubeFormat::ND, half>,
        AscendC::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, float>>
        matmulObj;

    AscendC::GlobalTensor<half>  aGlobal;
    AscendC::GlobalTensor<half>  bGlobal;
    AscendC::GlobalTensor<float> ansGlobal;

    AscendC::TQue<AscendC::QuePosition::VECIN,1> cQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN,1> partialMaxQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN,1> ansQueue;

    AscendC::TBuf<AscendC::TPosition::VECCALC> maxTmpBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumTmpBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> runningMaxBuf;

    BatchMatmulMaxSumTilling tilling;
};

__aicore__ inline void BatchMatmulMaxSumKernel::Init(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* ans,
    const BatchMatmulMaxSumTilling& tilling, AscendC::TPipe* pipe)
{
    this->tilling = tilling;
    const auto& ctd = tilling.cubeTilingData;

    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a),   tilling.B * ctd.M * ctd.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b),   tilling.B * ctd.Kb * ctd.N);
    ansGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ans), tilling.B);

    pipe->InitBuffer(cQueue,          1, ctd.baseM * ctd.baseN * sizeof(float));
    pipe->InitBuffer(partialMaxQueue, 1, ctd.baseM * sizeof(float));
    pipe->InitBuffer(ansQueue,        1, sizeof(float));

    pipe->InitBuffer(maxTmpBuf,       tilling.reduceMaxTmpSize);
    pipe->InitBuffer(sumTmpBuf,       tilling.reduceSumTmpSize);
    pipe->InitBuffer(runningMaxBuf,   ctd.baseM * sizeof(float));
}

__aicore__ inline void BatchMatmulMaxSumKernel::Process()
{
    const auto& ctd = tilling.cubeTilingData;
    const uint32_t mBlocks = Ceiling(ctd.M, ctd.baseM);
    const uint32_t nBlocks = Ceiling(ctd.N, ctd.baseN);

    const uint32_t blockIdx = AscendC::GetBlockIdx();
    const uint32_t blockNum = AscendC::GetBlockNum();

    for (uint32_t b = blockIdx; b < tilling.B; b += blockNum) {
        float ySum = 0.0f;
        for (uint32_t mBlock = 0; mBlock < mBlocks; ++mBlock) {
            AscendC::LocalTensor<float> runningMax = runningMaxBuf.Get<float>();
            AscendC::Duplicate(runningMax, -3.402823466e+38f, ctd.baseM);

            for (uint32_t nBlock = 0; nBlock < nBlocks; ++nBlock) {
                uint64_t aOff = static_cast<uint64_t>(b) * ctd.M * ctd.Ka
                              + static_cast<uint64_t>(mBlock) * ctd.baseM * ctd.Ka;
                uint64_t bOff = static_cast<uint64_t>(b) * ctd.Kb * ctd.N
                              + static_cast<uint64_t>(nBlock) * ctd.baseN;

                matmulObj.SetTensorA(aGlobal[aOff]);
                matmulObj.SetTensorB(bGlobal[bOff]);

                while (matmulObj.template Iterate<true>()) {
                    MatmulCompute();
                    GetPartialMax();
                    UpdateRunningMax();
                }
                matmulObj.End();
            }
            SumUpCompute();

            AscendC::LocalTensor<float> yPartial = ansQueue.DeQue<float>();
            ySum += yPartial.GetValue(0);
            ansQueue.FreeTensor(yPartial);
        }

        ansGlobal.SetValue(b, ySum);
    }
}

__aicore__ inline void BatchMatmulMaxSumKernel::MatmulCompute()
{
    AscendC::LocalTensor<float> cLocal = cQueue.AllocTensor<float>();
    matmulObj.template GetTensorC<true>(cLocal, false, true);
    cQueue.EnQue(cLocal);
}

__aicore__ inline void BatchMatmulMaxSumKernel::GetPartialMax()
{
    const auto& ctd = tilling.cubeTilingData;

    AscendC::LocalTensor<float> cLocal     = cQueue.DeQue<float>();
    AscendC::LocalTensor<float> partialMax = partialMaxQueue.AllocTensor<float>();
    AscendC::LocalTensor<uint8_t> maxTmp   = maxTmpBuf.Get<uint8_t>();

    uint32_t srcShape[2] = {
        static_cast<uint32_t>(ctd.baseM), 
        static_cast<uint32_t>(ctd.baseN)
    };

    AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, false>(
        partialMax, cLocal, maxTmp, srcShape, false);

    cQueue.FreeTensor(cLocal);
    partialMaxQueue.EnQue(partialMax);
}

__aicore__ inline void BatchMatmulMaxSumKernel::UpdateRunningMax()
{
    const auto& ctd = tilling.cubeTilingData;

    AscendC::LocalTensor<float> partialMax = partialMaxQueue.DeQue<float>();
    AscendC::LocalTensor<float> runningMax = runningMaxBuf.Get<float>();

    AscendC::Max(runningMax, runningMax, partialMax, ctd.baseM);

    partialMaxQueue.FreeTensor(partialMax);
}

__aicore__ inline void BatchMatmulMaxSumKernel::SumUpCompute()
{
    const auto& ctd = tilling.cubeTilingData;

    AscendC::LocalTensor<float> runningMax = runningMaxBuf.Get<float>();
    AscendC::LocalTensor<float> ansLocal   = ansQueue.AllocTensor<float>();
    AscendC::LocalTensor<uint8_t> sumTmp   = sumTmpBuf.Get<uint8_t>();

    uint32_t srcShape[2] = {
        static_cast<uint32_t>(ctd.baseM), 
        1U
    };

    AscendC::ReduceSum<float, AscendC::Pattern::Reduce::RA, false>(
        ansLocal, runningMax, sumTmp, srcShape, false);

    ansQueue.EnQue(ansLocal);
}

extern "C" __global__ __mix__(1, 2) void batch_matmul_max_sum_custom(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* ans,
    __gm__ uint8_t* __kfc_workspace__ workspace,
    BatchMatmulMaxSumTilling tilling)
{
    AscendC::TPipe pipe;
    BatchMatmulMaxSumKernel op;
    op.Init(a, b, ans, tilling, &pipe);
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.matmulObj, &tilling.cubeTilingData);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y,  const TensorGroupInfo& info_y,
    int64_t availableCoreNum,
    aclrtStream stream,
    bool transposeX1, bool transposeX2)
{
    const int64_t* x1Shape = info_x1.tensors[0].shape;
    const int64_t* x2Shape = info_x2.tensors[0].shape;

    uint32_t B = static_cast<uint32_t>(x1Shape[0]);
    uint32_t M, K, N;

    if (!transposeX1) {
        M = static_cast<uint32_t>(x1Shape[1]);
        K = static_cast<uint32_t>(x1Shape[2]);
    } else {
        M = static_cast<uint32_t>(x1Shape[2]);
        K = static_cast<uint32_t>(x1Shape[1]);
    }
    if (!transposeX2) {
        N = static_cast<uint32_t>(x2Shape[2]);
    } else {
        N = static_cast<uint32_t>(x2Shape[1]);
    }

    uint32_t blockNum = static_cast<uint32_t>(
        B < static_cast<uint32_t>(availableCoreNum) ? B : availableCoreNum);

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    BatchMatmulMaxSumTilling tilling = GenerateTiling(
        ascendcPlatform, B, M, N, K, 128, 128, blockNum);

    batch_matmul_max_sum_custom<<<blockNum, nullptr, stream>>>(
        x1, x2, y, nullptr, tilling);
}